:host {
    display: block;
}

.csg-card {
    background: var(--slds-g-color-surface-1, #ffffff);
    border: 1px solid var(--slds-g-color-border-1, #e5e5e5);
    border-radius: var(--slds-g-radius-border-4, 0.75rem);
    box-shadow: var(--slds-g-shadow-2, 0 2px 8px rgba(0, 0, 0, 0.08));
    padding: var(--slds-g-spacing-4, 1rem);
    font-family: var(--slds-g-font-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
}

/* Header */
.csg-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--slds-g-spacing-2, 0.5rem);
}

.csg-header__title {
    font-size: var(--slds-g-font-size-5, 1rem);
    font-weight: var(--slds-g-font-weight-7, 700);
    color: var(--slds-g-color-on-surface-1, #181818);
    letter-spacing: -0.01em;
}

.csg-header__badge {
    font-size: var(--slds-g-font-size-2, 0.75rem);
    font-weight: var(--slds-g-font-weight-6, 600);
    padding: 0.2rem 0.65rem;
    border-radius: var(--slds-g-radius-border-pill, 999px);
    background: var(--slds-g-color-surface-container-2, #f3f3f3);
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

/* Messages */
.csg-message {
    display: flex;
    align-items: center;
    gap: var(--slds-g-spacing-2, 0.5rem);
    padding: var(--slds-g-spacing-4, 1rem);
    border-radius: var(--slds-g-radius-border-3, 0.5rem);
    font-size: var(--slds-g-font-size-3, 0.8125rem);
    margin-top: var(--slds-g-spacing-3, 0.75rem);
}

.csg-message--error {
    background: var(--slds-g-color-error-container-1, #fef1f1);
    color: var(--slds-g-color-error-1, #ba0517);
}

.csg-message--empty {
    background: var(--slds-g-color-surface-container-1, #f8f8f8);
    color: var(--slds-g-color-on-surface-2, #5c5c5c);
}

/* Gauge */
.csg-gauge {
    position: relative;
    max-width: 240px;
    margin: 0 auto;
    padding-top: var(--slds-g-spacing-2, 0.5rem);
}

.gauge__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
}

.gauge__track-bg {
    stroke: var(--slds-g-color-surface-container-2, #eef0f2);
}

.gauge__segment {
    opacity: 0.9;
}

.gauge__needle-line {
    stroke: var(--slds-g-color-on-surface-1, #2b2b2b);
    stroke-width: 4;
    stroke-linecap: round;
}

.gauge__needle {
    transition: transform 120ms linear;
}

.gauge__hub {
    stroke: var(--slds-g-color-surface-1, #ffffff);
    stroke-width: 3;
}

.gauge__hub-inner {
    fill: var(--slds-g-color-surface-1, #ffffff);
}

/* Center readout */
.gauge__readout {
    position: absolute;
    top: 62%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    pointer-events: none;
}

.gauge__score {
    font-size: 2rem;
    font-weight: var(--slds-g-font-weight-7, 700);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
}

.gauge__range {
    font-size: var(--slds-g-font-size-2, 0.75rem);
    color: var(--slds-g-color-on-surface-3, #939393);
    margin-top: 0.15rem;
    font-variant-numeric: tabular-nums;
}

/* Legend */
.legend {
    display: flex;
    justify-content: space-between;
    gap: var(--slds-g-spacing-1, 0.25rem);
    margin-top: var(--slds-g-spacing-5, 1.25rem);
    padding-top: var(--slds-g-spacing-4, 1rem);
    border-top: 1px solid var(--slds-g-color-border-2, #eeeeee);
}

.legend__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    flex: 1;
    text-align: center;
    opacity: 0.55;
    transition: opacity 150ms ease;
}

.legend__item--active {
    opacity: 1;
}

.legend__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: var(--slds-g-radius-circle, 50%);
}

.legend__label {
    font-size: 0.62rem;
    font-weight: var(--slds-g-font-weight-6, 600);
    color: var(--slds-g-color-on-surface-1, #181818);
    line-height: 1.1;
}

.legend__range {
    font-size: 0.56rem;
    color: var(--slds-g-color-on-surface-3, #939393);
    font-variant-numeric: tabular-nums;
}

/* Tips */
.csg-tips {
    margin-top: var(--slds-g-spacing-5, 1.25rem);
    padding-top: var(--slds-g-spacing-4, 1rem);
    border-top: 1px solid var(--slds-g-color-border-2, #eeeeee);
}

.csg-tips__heading {
    display: flex;
    align-items: center;
    gap: var(--slds-g-spacing-2, 0.5rem);
    font-size: var(--slds-g-font-size-3, 0.8125rem);
    font-weight: var(--slds-g-font-weight-7, 700);
    color: var(--slds-g-color-on-surface-1, #181818);
    margin-bottom: var(--slds-g-spacing-3, 0.75rem);
}

.csg-tips__icon {
    --slds-c-icon-color-foreground-default: var(--slds-g-color-accent-1, #0176d3);
}

.csg-tips__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--slds-g-spacing-3, 0.75rem);
}

.csg-tips__item {
    display: flex;
    align-items: flex-start;
    gap: var(--slds-g-spacing-3, 0.75rem);
}

.csg-tips__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: var(--slds-g-radius-circle, 50%);
    background: var(--slds-g-color-success-1, #2e844a);
    flex-shrink: 0;
    margin-top: 0.1rem;
}

.csg-tips__text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
}

.csg-tips__title {
    font-size: var(--slds-g-font-size-3, 0.8125rem);
    font-weight: var(--slds-g-font-weight-6, 600);
    color: var(--slds-g-color-on-surface-1, #181818);
}

.csg-tips__body {
    font-size: var(--slds-g-font-size-2, 0.75rem);
    color: var(--slds-g-color-on-surface-2, #5c5c5c);
    line-height: 1.45;
}
