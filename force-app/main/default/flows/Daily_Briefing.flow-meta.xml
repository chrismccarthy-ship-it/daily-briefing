<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily Briefing — Screen Flow
  Two elements only: Apex action (does all the work) -> Screen (displays HTML).
  Deploy DailyBriefingController first, then this flow.
-->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <label>Daily Briefing</label>
    <processType>Flow</processType>
    <status>Active</status>
    <interviewLabel>Daily Briefing {!$Flow.CurrentDateTime}</interviewLabel>
    <runInMode>DefaultMode</runInMode>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Daily_Briefing</targetReference>
        </connector>
    </start>

    <actionCalls>
        <name>Get_Daily_Briefing</name>
        <label>Get Daily Briefing</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <actionName>DailyBriefingController</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>DailyBriefingController</nameSegment>
        <storeOutputAutomatically>true</storeOutputAutomatically>
        <connector>
            <targetReference>Briefing_Screen</targetReference>
        </connector>
    </actionCalls>

    <screens>
        <name>Briefing_Screen</name>
        <label>My Day</label>
        <locationX>176</locationX>
        <locationY>254</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
        <fields>
            <name>BriefingHtml</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>{!Get_Daily_Briefing.htmlOutput}</fieldText>
            <isRequired>false</isRequired>
        </fields>
    </screens>
</Flow>
